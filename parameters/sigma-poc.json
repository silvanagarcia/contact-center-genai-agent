{
  "_description": "Parametros para el despliegue de la POC de Sigma Foodservice.",

  "global": {
    "EnvironmentName":    "poc",
    "AWSRegion":          "us-east-1",
    "ArtifactsBucket":    "sigma-poc-artifacts-825765398662",
    "ContentBucket":      "sigma-poc-kb-content-825765398662",
    "ConnectInstanceArn": "arn:aws:connect:us-east-1:825765398662:instance/b2116e6f-1693-4abf-8f91-a47920a8a38c"
  },

  "stack_1_knowledge_base": {
    "StackName":          "sigma-poc-knowledge-base",
    "Status":             "DEPLOYED",
    "KnowledgeBaseId":    "8S8WC4DRZY",
    "Template":           "infrastructure/bedrock-KB.yaml",
    "Parameters": {
      "pKnowledgeBaseBucketName":        "sigma-poc-kb-content-825765398662",
      "pInputDocumentUploadFolderPrefix": "sigma/",
      "pEmbedModel":                     "amazon.titan-embed-text-v2:0",
      "pChunkingStrategy":               "Fixed-size chunking",
      "pMaxTokens":                      "600",
      "pOverlapPercentage":              "10",
      "pArtifactsBucket":                "sigma-poc-artifacts-825765398662"
    }
  },

  "stack_2_rag_solution": {
    "StackName":          "sigma-poc-rag-solution",
    "Status":             "DEPLOYED",
    "LexBotId":           "UKCXRKYGFR",
    "LexBotAliasId":      "SQYD2WAVEK",
    "ContactFlowId":      "66bf08cf-b1eb-4a9e-ad58-da827c6a1f4d",
    "Template":           "infrastructure/contact-center-RAG-solution.yaml",
    "Parameters": {
      "pBotName":              "sigma-poc-bot",
      "pConversationTurns":    "4",
      "pConnectInstanceARN":   "arn:aws:connect:us-east-1:825765398662:instance/b2116e6f-1693-4abf-8f91-a47920a8a38c",
      "pContactFlowName":      "Sigma POC Contact Flow",
      "pKBID":                 "8S8WC4DRZY",
      "pKBS3Bucket":           "sigma-poc-kb-content-825765398662",
      "pArtifactsBucket":      "sigma-poc-artifacts-825765398662",
      "pLexLocaleId":          "es_419",
      "pLexVoiceId":           "Mia"
    }
  },

  "stack_sigma_db": {
    "StackName":          "sigma-poc-providers-db",
    "Template":           "infrastructure/sigma/sigma-providers-db.yaml",
    "Parameters": {
      "EnvironmentName":   "poc"
    }
  },

  "stack_sigma_auth": {
    "StackName":          "sigma-poc-customer-auth",
    "Template":           "infrastructure/sigma/sigma-customer-auth.yaml",
    "Parameters": {
      "EnvironmentName":    "poc",
      "ProvidersTableName": "sigma-providers-poc",
      "SessionsTableName":  "sigma-sessions-poc",
      "ArtifactsBucket":    "sigma-poc-artifacts-825765398662"
    }
  },

  "stack_sigma_proactive": {
    "StackName":          "sigma-poc-proactive-messages",
    "Template":           "infrastructure/sigma/sigma-proactive-messages.yaml",
    "Parameters": {
      "EnvironmentName":              "poc",
      "ProvidersTableName":           "sigma-providers-poc",
      "ProactiveLogTableName":        "sigma-proactive-log-poc",
      "ConnectInstanceArn":           "arn:aws:connect:us-east-1:825765398662:instance/b2116e6f-1693-4abf-8f91-a47920a8a38c",
      "RecordatorioCampaignId":       "PENDING - completar despues de crear campana en consola",
      "BloqueoCampaignId":            "PENDING - completar despues de crear campana en consola",
      "ArtifactsBucket":              "sigma-poc-artifacts-825765398662",
      "DaysSinceLastOrderThreshold":  "14",
      "MaxDailyMessagesPerProvider":  "1"
    }
  },

  "stack_sigma_whatsapp": {
    "StackName":          "sigma-poc-whatsapp",
    "Template":           "infrastructure/sigma/sigma-whatsapp.yaml",
    "Parameters": {
      "EnvironmentName":         "poc",
      "ConnectInstanceArn":      "arn:aws:connect:us-east-1:825765398662:instance/b2116e6f-1693-4abf-8f91-a47920a8a38c",
      "ConnectContactFlowId":    "66bf08cf-b1eb-4a9e-ad58-da827c6a1f4d",
      "WhatsAppPhoneNumberId":   "PENDING_EMBEDDED_SIGNUP",
      "WhatsAppWABAId":          "PENDING_EMBEDDED_SIGNUP"
    }
  },

  "seed": {
    "ProvidersTable":  "sigma-providers-poc",
    "Region":          "us-east-1",
    "Command":         "python3 src/sigma/seed/seed_providers.py --table sigma-providers-poc --region us-east-1 --profile sigma-poc"
  },

  "content_upload": {
    "Description": "Subir contenido de FAQs y catalogo al bucket de la Knowledge Base",
    "Command":      "aws s3 sync content/sigma/ s3://sigma-poc-kb-content-825765398662/sigma/ --region us-east-1 --profile sigma-poc"
  }
}
